SCEC_ENV=development
SCEC_AUTH_MODE=disabled
# In production set SCEC_AUTH_MODE=token and a randomly generated 32+ character SCEC_SERVICE_TOKEN
SCEC_SERVICE_TOKEN=

# v11.3 offline synthetic previews; default off, never production authorization.
SCEC_ALERTS_STAGING_ENABLED=0
SCEC_HUMAN_AUTH_ENABLED=0
SCEC_PERSISTENCE_ENABLED=0
SCEC_OUTBOUND_ENABLED=0
SCEC_DELETION_ENABLED=0
SCEC_FEDERATION_ENABLED=0
SCEC_PRODUCTION_WRITES_ENABLED=0
SCEC_PUBLICATION_ENABLED=0
SCEC_SYNDICATION_ENABLED=0
SCEC_SCHEDULED_DELIVERY_ENABLED=0
SCEC_TOKEN_EXCHANGE_ENABLED=0

SCEC_MEDIA_STAGING_ENABLED=0

# Offline synthetic citation previews only
SCEC_CITATION_STAGING_ENABLED=0

# Offline synthetic event calendar previews only
SCEC_EVENTS_STAGING_ENABLED=0

# Offline synthetic preview only
SCEC_PARTNERS_STAGING_ENABLED=0

# Offline synthetic preview only
SCEC_EMBEDS_STAGING_ENABLED=0
# Empty denies all embed previews; operator may set exact HTTPS origins in isolated staging
SCEC_EMBED_ALLOWED_ORIGINS=

# Offline synthetic preview only
SCEC_AUDIENCE_STAGING_ENABLED=0
