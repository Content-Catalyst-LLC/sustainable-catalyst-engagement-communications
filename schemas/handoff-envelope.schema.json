{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SCEC Handoff Envelope v1",
  "type": "object",
  "required": [
    "contract_version",
    "correlation_id",
    "origin",
    "destination",
    "subject"
  ],
  "properties": {
    "contract_version": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "origin": {
      "type": "object"
    },
    "destination": {
      "type": "string"
    },
    "subject": {
      "type": "object"
    },
    "approved": {
      "type": "boolean"
    }
  }
}
